# Odyssey Node Configuration
# Local development
IP=127.0.0.1
PORT=9650
PROTOCOL=http
NETWORK_ID=1

# Testnet HTTPS (recommended for production)
# IP=testnet-backup-rpc.dioneprotocol.com
# PORT=443
# PROTOCOL=https
# NETWORK_ID=5

# Legacy Environment Variables (for backward compatibility)
TEST_IP=127.0.0.1
ODYSSEY_PORT=9650
TEST_NETWORK_ID=1

# Additional Environment Variables (for specific scripts)
PROTOCOL_WS=ws
LOCALHOST=localhost
IP_INDEXER=127.0.0.1

# Authentication (if needed)
# PASSWORD=your_password
# TOKEN=your_token
# USER=your_username

# Transaction-specific variables
PRIVATE_KEY=your_private_key_here_without_0x_prefix
WALLET_ADDRESS=your_ethereum_style_wallet_address
REWARD_ADDRESS=your_ochain_reward_address
NODE_ID=your_validator_node_id
DELEGATION_FEE=2

# Example configurations for different networks:
# Mainnet: NETWORK_ID=1, IP=your_mainnet_node_ip
# Testnet: NETWORK_ID=5, IP=your_testnet_node_ip
# Local: NETWORK_ID=1, IP=127.0.0.1, PORT=9650